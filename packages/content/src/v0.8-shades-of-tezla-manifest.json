  "skills": [
    { "id": "tezla.skill.lightning-storm", "name": "雷暴", "description": "每轮一次：翻面，获得蓝或绿法力及蓝或红法力。", "ruleText": "选择两枚法力令牌：第一枚蓝/绿，第二枚蓝/红。", "effect": { "type": "special", "rule": "tezla-lightning-storm" }, "oncePerRound": true, "sourceRef": "Braevalar skill: Lightning Storm", "implementation": "full", "assetAlias": "skill.tezla.lightning-storm" },
    { "id": "tezla.skill.elemental-resistance", "name": "元素抗性", "description": "每回合一次：下一次英雄受到单次火焰/寒冰攻击时减伤 2，其他攻击减伤 1。", "ruleText": "忽略下一次分配给英雄的单次元素攻击 2 点伤害，或其他攻击 1 点伤害。", "effect": { "type": "special", "rule": "tezla-elemental-resistance" }, "oncePerRound": false, "sourceRef": "Braevalar skill: Elemental Resistance", "implementation": "full", "assetAlias": "skill.tezla.elemental-resistance" },
    { "id": "tezla.skill.thunderstorm", "name": "风暴", "description": "每轮一次：翻面，获得绿或蓝法力及绿或白法力。", "ruleText": "选择两枚法力令牌：第一枚绿/蓝，第二枚绿/白。", "effect": { "type": "special", "rule": "tezla-thunderstorm" }, "oncePerRound": true, "sourceRef": "Braevalar skill: Thunderstorm", "implementation": "full", "assetAlias": "skill.tezla.thunderstorm" },
    { "id": "tezla.skill.shapeshift", "name": "变形", "description": "每回合一次：一张提供固定移动、攻击或格挡的基础行动牌，改为同值的另外一种资源。", "ruleText": "转换一张基础行动牌的固定移动/攻击/格挡，攻击和格挡保留元素。", "effect": { "type": "special", "rule": "tezla-shapeshift" }, "oncePerRound": false, "sourceRef": "Braevalar skill: Shapeshift", "implementation": "full", "assetAlias": "skill.tezla.shapeshift" },
    { "id": "tezla.skill.feral-allies", "name": "野性盟友", "description": "探索费用始终 -1；每回合一次获得攻击 1或使一个敌人的一次攻击 -1。", "ruleText": "探索费用 -1；激活时选择攻击 1或目标攻击 -1。", "effect": { "type": "choose-one", "labels": ["攻击 1", "敌人攻击 -1"], "options": [{ "resource": "attack", "amount": 1 }, { "type": "modify-enemy", "modifier": "attack", "amount": -1, "expires": "end-combat" }] }, "oncePerRound": false, "sourceRef": "Braevalar skill: Feral Allies", "implementation": "full", "assetAlias": "skill.tezla.feral-allies" },
    { "id": "tezla.skill.forked-lightning", "name": "叉形闪电", "description": "每回合一次：对至多三个不同敌人分别获得寒火远程攻击 1。", "ruleText": "获得寒火远程攻击 1；可指定至多三个敌人。", "effect": { "resource": "attack", "amount": 1, "attackKind": "ranged", "element": "cold-fire" }, "oncePerRound": false, "sourceRef": "Braevalar skill and FAQ: Forked Lightning", "implementation": "full", "assetAlias": "skill.tezla.forked-lightning" },
    { "id": "tezla.skill.beguile", "name": "迷醉", "description": "每回合一次：通常影响 3；在工事地点为 2；在魔法林地为 4。", "ruleText": "根据当前位置获得影响 2、3或4。", "effect": { "type": "special", "rule": "tezla-beguile" }, "oncePerRound": false, "sourceRef": "Braevalar skill: Beguile", "implementation": "full", "assetAlias": "skill.tezla.beguile" },
    { "id": "tezla.skill.secret-ways", "name": "隐秘之路", "description": "每回合一次移动 1；可用 5 移动进入山脉；支付蓝色法力后本回合可用 2 移动进入湖泊。", "ruleText": "移动 1，并允许山脉费用 5；可支付蓝色法力使湖泊费用为 2。", "effect": { "type": "special", "rule": "tezla-secret-ways" }, "oncePerRound": false, "sourceRef": "Braevalar skill: Secret Ways", "implementation": "full", "assetAlias": "skill.tezla.secret-ways" },
    { "id": "tezla.skill.regenerate", "name": "再生", "description": "每回合一次：支付任意颜色法力并移除一张手牌伤牌；单人游戏中支付绿色法力时再抽一张。", "ruleText": "支付法力并移除一张手牌伤牌；支付绿色时抽一张。", "effect": { "type": "special", "rule": "tezla-regenerate", "target": "hand-card" }, "oncePerRound": false, "sourceRef": "Braevalar skill and solo interpretation: Regenerate", "implementation": "full", "assetAlias": "skill.tezla.regenerate" }
  ],
