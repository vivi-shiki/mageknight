      "strongEffect": { "type": "sequence", "effects": [{ "type": "spend-mana", "color": "blue", "amount": 1 }, { "resource": "move", "amount": 4 }, { "type": "choose-one", "labels": ["平原 -1", "森林 -1", "丘陵 -1", "沙漠 -1", "荒地 -1", "山脉 -1", "湖泊 -1"], "options": [
        { "type": "terrain-cost", "terrains": ["plains"], "mode": "reduce", "amount": 1, "minimum": 2, "expires": "end-turn" },
