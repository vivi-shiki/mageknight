        { "type": "terrain-cost", "terrains": ["hills"], "mode": "reduce", "amount": 1, "minimum": 2, "expires": "end-turn" },
        { "type": "terrain-cost", "terrains": ["desert"], "mode": "reduce", "amount": 1, "minimum": 2, "expires": "end-turn" },
        { "type": "terrain-cost", "terrains": ["wasteland"], "mode": "reduce", "amount": 1, "minimum": 2, "expires": "end-turn" },
        { "type": "terrain-cost", "terrains": ["mountain"], "mode": "reduce", "amount": 1, "minimum": 2, "expires": "end-turn" },
        { "type": "terrain-cost", "terrains": ["lake"], "mode": "reduce", "amount": 1, "minimum": 2, "allowLake": true, "expires": "end-turn" }
      ] }] },
      "sourceRef": "Braevalar basic action card: Druidic Paths", "implementation": "full", "assetAlias": "card.tezla.druidic-paths"
    },
    {
      "id": "tezla.card.one-with-the-land", "name": "大地合一", "color": "green", "kind": "basic",
      "basicText": "移动 2、治疗 1或格挡 2。",
      "strongText": "移动 4、治疗 2，或获得等于所在空间未修正移动费用的格挡；白天为火焰格挡，夜晚为寒冰格挡。",
